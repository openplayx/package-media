# CI-only instrumentation for the example host and its native plugins.
# Prebuilt Flutter engines and media dependencies are not instrumented here.
if("$ENV{OPX_NATIVE_SANITIZER}" STREQUAL "")
  return()
endif()
set(OPX_SANITIZER "$ENV{OPX_NATIVE_SANITIZER}")
if(NOT OPX_SANITIZER MATCHES "^(address|thread)$")
  message(FATAL_ERROR "Unknown OPX_NATIVE_SANITIZER: ${OPX_SANITIZER}")
endif()
if(MSVC)
  if(NOT OPX_SANITIZER STREQUAL "address")
    message(FATAL_ERROR "MSVC supports this check with AddressSanitizer only")
  endif()
  # /RTC and incremental linking are incompatible with MSVC ASan.
  foreach(lang C CXX)
    foreach(config DEBUG RELWITHDEBINFO RELEASE MINSIZEREL)
      string(REGEX REPLACE "/RTC[^ ]*" "" CMAKE_${lang}_FLAGS_${config} "${CMAKE_${lang}_FLAGS_${config}}")
      string(REPLACE "/ZI" "/Zi" CMAKE_${lang}_FLAGS_${config} "${CMAKE_${lang}_FLAGS_${config}}")
    endforeach()
  endforeach()
  add_compile_options(/fsanitize=address /Zi)
  add_link_options(/INCREMENTAL:NO /DEBUG)
  get_filename_component(OPX_COMPILER_DIR "${CMAKE_CXX_COMPILER}" DIRECTORY)
  file(GLOB OPX_ASAN_RUNTIME "${OPX_COMPILER_DIR}/clang_rt.asan_dynamic-x86_64.dll")
  if(NOT OPX_ASAN_RUNTIME)
    message(FATAL_ERROR "MSVC ASan runtime is missing; install the C++ AddressSanitizer component")
  endif()
  install(FILES ${OPX_ASAN_RUNTIME} DESTINATION "$<TARGET_FILE_DIR:${BINARY_NAME}>")
elseif(CMAKE_CXX_COMPILER_ID MATCHES "Clang|GNU")
  if(OPX_SANITIZER STREQUAL "address")
    add_compile_options(-fsanitize=address,undefined -fno-sanitize-recover=all)
    add_link_options(-fsanitize=address,undefined -fno-sanitize-recover=all)
  else()
    add_compile_options(-fsanitize=thread)
    add_link_options(-fsanitize=thread)
  endif()
  add_compile_options(-g -O1 -fno-omit-frame-pointer)
else()
  message(FATAL_ERROR "Sanitizer toolchain is unsupported: ${CMAKE_CXX_COMPILER_ID}")
endif()
string(TOUPPER "${OPX_SANITIZER}" OPX_SANITIZER_DEFINE)
add_compile_definitions(OPX_SANITIZER_${OPX_SANITIZER_DEFINE}=1)
find_package(Threads REQUIRED)
add_executable(opx_sanitizer_probe "${CMAKE_CURRENT_LIST_DIR}/native_sanitizer_probe.cc")
target_compile_features(opx_sanitizer_probe PRIVATE cxx_std_14)
target_link_libraries(opx_sanitizer_probe PRIVATE Threads::Threads)
set_target_properties(opx_sanitizer_probe PROPERTIES
  RUNTIME_OUTPUT_DIRECTORY "${CMAKE_BINARY_DIR}/opx-sanitizer-probe")
if(MSVC)
  add_custom_command(TARGET opx_sanitizer_probe POST_BUILD
    COMMAND "${CMAKE_COMMAND}" -E copy_if_different ${OPX_ASAN_RUNTIME} "$<TARGET_FILE_DIR:opx_sanitizer_probe>")
endif()
message(STATUS "OpenPlayX native sanitizer: ${OPX_SANITIZER} (runner and compiled plugins)")
